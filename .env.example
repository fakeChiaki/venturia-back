# Copiar a .env y ajustar valores
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=venturia
DB_PASSWORD=venturia_dev
DB_NAME=venturia
DB_LOGGING=false
# true → ejecuta migraciones pendientes al iniciar la app (usado en Docker)
DB_MIGRATIONS_RUN=false

# Genera dos strings aleatorios distintos de ≥32 chars (openssl rand -hex 32)
# En Windows sin openssl: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=cambia_esto_por_un_string_aleatorio_de_minimo_32_caracteres_aaaa
JWT_REFRESH_SECRET=cambia_esto_por_otro_string_aleatorio_de_minimo_32_caracteres_bb
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

REDIS_HOST=localhost
REDIS_PORT=6379

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=tucorreo@gmail.com
MAIL_PASS=contraseña_de_aplicacion_sin_espacios
MAIL_FROM=Venturia <tucorreo@gmail.com>

# MinIO — almacenamiento de archivos (CVs, imágenes)
# Consola web disponible en http://localhost:9001 (usuario/clave = MINIO_ACCESS_KEY / MINIO_SECRET_KEY)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=venturia_minio
MINIO_SECRET_KEY=venturia_minio_secret
MINIO_BUCKET=venturia
# URL pública desde la que el cliente descarga los archivos
MINIO_PUBLIC_URL=http://localhost:9000

# OAuth Google — registrar app en https://console.cloud.google.com
# Si no tienes credenciales, deja los valores placeholder para que la app arranque
# (el login con Google no funcionará, pero el resto de endpoints sí)
GOOGLE_CLIENT_ID=placeholder
GOOGLE_CLIENT_SECRET=placeholder
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
